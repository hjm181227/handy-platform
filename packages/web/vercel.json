{
  "buildCommand": "echo 'Skipping build - using pre-built files'",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "echo 'Skipping install'",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}