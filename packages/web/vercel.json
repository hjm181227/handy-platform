{
  "buildCommand": "echo 'Using pre-built files from local'",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "echo 'Skipping install - using pre-built files'",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
