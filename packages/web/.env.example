# API 설정
VITE_API_BASE_URL=http://localhost:11000

# 환경 설정 (Sentry 활성화 조건: production | staging | stage)
VITE_ENVIRONMENT=development
VITE_APP_ENV=development

# 디버그 모드
VITE_ENABLE_DEBUG=true

# 소셜 로그인 (필수)
# VITE_KAKAO_APP_KEY가 없으면 initKakaoSdk()가 명시적으로 실패한다.
# 환경별로 다른 카카오 앱을 쓴다면 환경마다 다른 값을 넣어야 한다.
VITE_KAKAO_APP_KEY=
VITE_GOOGLE_CLIENT_ID=

# 결제
VITE_TOSS_CLIENT_KEY=

# 선택적 서비스 이용 통계 (Firebase Analytics)
# 기본값은 비활성이다. 아래 Firebase 값 5개를 모두 비우면 프로덕션 수집을 초기화하지 않는다.
# 활성화할 때는 5개와 앱 버전/빌드 번호를 모두 배포 환경에 주입해야 하며, 일부 값만 있으면 빌드가 실패한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_ANALYTICS_DEBUG=false
VITE_APP_VERSION=
VITE_BUILD_NUMBER=

# 에러 모니터링
VITE_SENTRY_DSN=

# 빌드 타임 전용 (소스맵 업로드). 설정된 경우에만 소스맵을 생성/업로드하고
# 업로드 후 삭제한다. 비워두면 소스맵 자체를 만들지 않는다.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=handy
SENTRY_PROJECT=handy-web
