{
  "name": "@handy-platform/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local",
    "dev:dev": "vite --mode development",
    "dev:stage": "vite --mode stage",
    "dev:prod": "vite --mode production",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode development",
    "build:stage": "vite build --mode stage",
    "build:prod": "vite build --mode production",
    "build:stage:safe": "tsc && vite build --mode stage",
    "build:prod:safe": "tsc && vite build --mode production",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy:stage": "vercel",
    "deploy:prod": "vercel --prod",
    "postinstall": "node scripts/ensure-react18.cjs"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.2.7",
    "@fontsource/libre-bodoni": "^5.2.7",
    "@fontsource/pretendard": "^5.2.5",
    "@handy-platform/shared": "file:../shared",
    "@hookform/resolvers": "^5.2.1",
    "@sentry/react": "^10.45.0",
    "@sentry/vite-plugin": "^5.1.1",
    "@tanstack/react-query": "^5.85.5",
    "@tosspayments/tosspayments-sdk": "^2.5.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/three": "^0.184.0",
    "@vercel/edge-config": "^1.4.3",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^23.16.8",
    "lucide-react": "^0.541.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.4",
    "react-icons": "^5.5.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^7.8.2",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vercel/node": "^5.4.1",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "three": "^0.170.0",
    "typescript": "^5.0.2",
    "vercel": "latest",
    "vite": "^4.4.5"
  }
