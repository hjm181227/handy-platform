default_platform(:ios)

ASC_API_KEY_PATH = File.expand_path("~/Projects/Handy_Design_Tool/credentials/ios/AuthKey_W9CK6D87T7.p8")

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    build_app(
      workspace: "ios/HandyPlatform.xcworkspace",
      scheme: "HandyTemp",
      configuration: "Release",
      export_options: "ios/ExportOptions.plist",
      output_directory: "build",
      output_name: "HandyPlatform.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates",
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"] || "W9CK6D87T7",
      issuer_id: ENV["ASC_API_ISSUER_ID"] || "e40f6783-ba51-4b34-8f5a-f620821fbd15",
      key_filepath: ASC_API_KEY_PATH,
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/HandyPlatform.ipa",
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    build_app(
      workspace: "ios/HandyPlatform.xcworkspace",
      scheme: "HandyTemp",
      configuration: "Release",
      export_options: "ios/ExportOptions.plist",
      output_directory: "build",
      output_name: "HandyPlatform.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates",
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"] || "W9CK6D87T7",
      issuer_id: ENV["ASC_API_ISSUER_ID"] || "e40f6783-ba51-4b34-8f5a-f620821fbd15",
      key_filepath: ASC_API_KEY_PATH,
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: "build/HandyPlatform.ipa",
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      ignore_language_directory_validation: true,
      metadata_path: "fastlane/metadata/ios",
    )
  end

  desc "Upload metadata only (no build, no binary)"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"] || "W9CK6D87T7",
      issuer_id: ENV["ASC_API_ISSUER_ID"] || "e40f6783-ba51-4b34-8f5a-f620821fbd15",
      key_filepath: ASC_API_KEY_PATH,
    )

    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      ignore_language_directory_validation: true,
      metadata_path: "fastlane/metadata/ios",
      force: true,
    )
  end

  desc "Build only (no upload)"
  lane :build do
    build_app(
      workspace: "ios/HandyPlatform.xcworkspace",
      scheme: "HandyTemp",
      configuration: "Release",
      export_options: "ios/ExportOptions.plist",
      output_directory: "build",
      output_name: "HandyPlatform.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates",
    )
  end
end

GOOGLE_PLAY_JSON_KEY = File.expand_path("~/Projects/Handy_Design_Tool/credentials/android/google-play-service-account.json")

platform :android do
  desc "Build AAB and upload to Google Play (internal track)"
  lane :beta do
    upload_to_play_store(
      track: "internal",
      release_status: "draft",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: GOOGLE_PLAY_JSON_KEY,
      package_name: "com.handyapp",
    )
  end

  desc "Build AAB only"
  lane :build do
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release",
    )
  end
end
