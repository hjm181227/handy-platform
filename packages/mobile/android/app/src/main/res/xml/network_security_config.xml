<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Development: Allow all cleartext traffic -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Specific domains (fallback) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">stage-handy.com</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.45.57</domain>
        <domain includeSubdomains="true">192.168.45.86</domain>
        <domain includeSubdomains="true">192.168.45.188</domain>
        <domain includeSubdomains="true">172.30.1.61</domain>
        <domain includeSubdomains="true">172.30.1.86</domain>
        <domain includeSubdomains="true">16.176.147.141</domain>
    </domain-config>
</network-security-config>