    "jpeg-js": "^0.4.4",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-fast-tflite": "^2.0.0",
    "react-native-fs": "^2.20.0",
    "react-native-image-crop-picker": "^0.51.0",
    "react-native-image-picker": "^7.1.2",
    "react-native-image-resizer": "^1.4.5",
