    "ios:stage": "cross-env REACT_NATIVE_ENV=stage react-native run-ios",
    "ios:prod": "cross-env REACT_NATIVE_ENV=production react-native run-ios",
    "start": "react-native start",
    "start:dev": "cross-env REACT_NATIVE_ENV=development react-native start",
    "start:stage": "cross-env REACT_NATIVE_ENV=stage react-native start",
    "start:prod": "cross-env REACT_NATIVE_ENV=production react-native start",
    "clean": "react-native clean",
    "build:android": "cross-env REACT_NATIVE_ENV=production cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cross-env REACT_NATIVE_ENV=production cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
