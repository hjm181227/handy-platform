    "@react-native-community/cli-platform-android": "^15.0.1",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/metro-config": "0.85.0",
    "@types/react": "^19.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "cross-env": "^10.1.0",
    "react-test-renderer": "19.2.3",
    "typescript": "5.0.4"
