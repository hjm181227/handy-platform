{
  "name": "@handy-platform/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "cross-env REACT_NATIVE_ENV=development react-native run-android",
    "android:stage": "cross-env REACT_NATIVE_ENV=stage react-native run-android",
    "android:prod": "cross-env REACT_NATIVE_ENV=production react-native run-android",
    "ios": "react-native run-ios",
