{
  "name": "@handy-platform/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "cross-env REACT_NATIVE_ENV=development react-native run-android",
    "android:stage": "cross-env REACT_NATIVE_ENV=stage react-native run-android",
    "android:prod": "cross-env REACT_NATIVE_ENV=production react-native run-android",
    "ios": "react-native run-ios",
    "ios:dev": "cross-env REACT_NATIVE_ENV=development react-native run-ios",
    "ios:stage": "cross-env REACT_NATIVE_ENV=stage react-native run-ios",
    "ios:prod": "cross-env REACT_NATIVE_ENV=production react-native run-ios",
    "start": "react-native start",
    "start:dev": "cross-env REACT_NATIVE_ENV=development react-native start",
    "start:stage": "cross-env REACT_NATIVE_ENV=stage react-native start",
    "start:prod": "cross-env REACT_NATIVE_ENV=production react-native start",
    "postinstall": "node scripts/patch-react-native-fs.js",
    "clean": "react-native clean",
    "build:android": "cross-env REACT_NATIVE_ENV=production cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cross-env REACT_NATIVE_ENV=production cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@dr.pogodin/react-native-fs": "^2.32.0",
    "@handy-platform/shared": "*",
