{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nail Detection Dataset Metadata",
  "description": "Schema for nail detection dataset metadata",
  "type": "object",
  "required": ["version", "name", "created_at", "statistics", "splits"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Dataset version (semver format)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "description": "Dataset name"
    },
    "description": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "statistics": {
      "type": "object",
      "properties": {
        "total_images": { "type": "integer" },
        "total_annotations": { "type": "integer" },
        "images_with_card": { "type": "integer" },
        "images_thumb_only": { "type": "integer" },
        "images_four_fingers": { "type": "integer" }
      }
    },
    "splits": {
      "type": "object",
      "properties": {
        "train": {
          "type": "object",
          "properties": {
            "images": { "type": "integer" },
            "annotations": { "type": "integer" }
          }
        },
        "val": {
          "type": "object",
          "properties": {
            "images": { "type": "integer" },
            "annotations": { "type": "integer" }
          }
        },
        "test": {
          "type": "object",
          "properties": {
            "images": { "type": "integer" },
            "annotations": { "type": "integer" }
          }
        }
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "collection_info": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lighting_conditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skin_tone_distribution": {
          "type": "object"
        },
        "device_types": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "annotation_format": {
      "type": "string",
      "enum": ["yolo", "coco", "pascal_voc"]
    },
    "license": {
      "type": "string"
    }
  }
}
