{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model OTA Manifest",
  "description": "Schema for model over-the-air update manifest served from CDN",
  "type": "object",
  "required": ["version", "models"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Manifest schema version"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["latest", "files"],
        "properties": {
          "latest": {
            "type": "string",
            "description": "Latest stable version"
          },
          "minimum_app_version": {
            "type": "string",
            "description": "Minimum app version required for this model"
          },
          "files": {
            "type": "object",
            "properties": {
              "android": {
                "type": "object",
                "required": ["url", "size", "checksum"],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "size": {
                    "type": "integer",
                    "description": "File size in bytes"
                  },
                  "checksum": {
                    "type": "string",
                    "description": "SHA256 checksum"
                  },
                  "format": {
                    "type": "string",
                    "enum": ["tflite"]
                  }
                }
              },
              "ios": {
                "type": "object",
                "required": ["url", "size", "checksum"],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "size": {
                    "type": "integer",
                    "description": "File size in bytes"
                  },
                  "checksum": {
                    "type": "string",
                    "description": "SHA256 checksum"
                  },
                  "format": {
                    "type": "string",
                    "enum": ["mlmodel", "mlpackage"]
                  }
                }
              }
            }
          },
          "release_notes": {
            "type": "string"
          },
          "deprecated_versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
