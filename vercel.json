{
  "framework": "vite",
  "buildCommand": "node packages/web/vercel-build.cjs",
  "outputDirectory": "packages/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
